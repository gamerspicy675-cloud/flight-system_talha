    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  f.flight_number,\n  f.origin,\n  f.destination,\n  f.total_capacity,\n  COUNT(b.id) FILTER (WHERE b.status = 'CONFIRMED') AS confirmed_passengers,\n  COALESCE(SUM(b.total_paid) FILTER (WHERE b.status = 'CONFIRMED'), 0) AS total_revenue,\n  ROUND((COUNT(b.id) FILTER (WHERE b.status = 'CONFIRMED')::decimal / NULLIF(f.total_capacity, 0)) * 100, 2) AS load_factor_percent\nFROM flights f\nLEFT JOIN bookings b ON f.id = b.flight_id\nGROUP BY f.id, f.flight_number, f.origin, f.destination, f.total_capacity;",
        "options": {}
      },
