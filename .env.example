# Copy this file to .env and replace the placeholder with your database URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?ssl=require

# Optional application settings
PROJECT_NAME=Flight Management System
API_V1_STR=/api/v1

# Policy ingestion
PINECONE_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY and GEMINI_KEY are also accepted as alternatives to GEMINI_API_KEY.
PINECONE_INDEX_NAME=flight-policies
